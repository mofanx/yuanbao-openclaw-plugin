// =====================================================================
// 元宝 ⇄ Devin CLI 集成 —— 完整可粘贴 OpenClaw 配置示例
// 文档：docs/devin-integration.md
//
// 用法：
//   1. 替换下方 BRIDGE_PATH 为 devin-acp-auth-bridge.mjs 的绝对路径
//   2. 拷贝到 ~/.openclaw/config.json5（或与现有配置合并）
//   3. 填写 channels.yuanbao.appKey / appSecret
//   4. 完成 Devin 认证（见 §2 Auth 配置）：
//        devin auth login --force-manual-token-flow   # headless 环境
//        devin auth status                            # 确认已登录
//   5. openclaw gateway restart
//
// 为什么用 bridge 而不直接 "devin acp"：
//   Devin CLI 2026.5.26+ 的 ACP 模式故意不使用本地 devin auth login 的凭据，
//   要求 ACP host 在调用 authenticate 时传入 _meta.api_key。
//   acpx 不会发送这个字段，所以需要 bridge 做中转认证。
//   bridge 会从 ~/.local/share/devin/credentials.toml 自动读取 windsurf_api_key。
//
// 兼容性：已在 devin 2026.8.18、openclaw 2026.6.11、插件 2.17.0、Ubuntu 22.04/24.04 测试
// =====================================================================
{
  acp: {
    enabled: true,
    dispatch: { enabled: true },
    backend: "acpx",
    defaultAgent: "devin",
    allowedAgents: ["devin"],
    maxConcurrentSessions: 4,
    stream: {
      // 与 channels.yuanbao.idleMs 协调：ACP 端聚合更短，元宝侧聚合更长
      coalesceIdleMs: 300,
      maxChunkChars: 1200,
    },
    runtime: {
      ttlMinutes: 120,
    },
  },

  plugins: {
    entries: {
      acpx: {
        enabled: true,
        config: {
          // ACP 在元宝里是非交互式的——必须 approve-all，否则写文件/执行 shell 会因
          // 找不到 TTY 而以 AcpRuntimeError 终止。
          permissionMode: "approve-all",
          // 权限实际被拒绝时优雅降级，避免崩溃
          nonInteractivePermissions: "deny",
          probeAgent: "devin",
          // ★ 关键：把 devin 注册为 acpx agent alias，使用认证桥接器
          //   BRIDGE_PATH = 本仓库 scripts/devin-acp-auth-bridge.mjs 的绝对路径
          agents: {
            devin: {
              command: "node",
              args: ["/BRIDGE_PATH/scripts/devin-acp-auth-bridge.mjs"],
              // 可选：指定 devin 可执行文件路径（PATH 中有 devin 时可省略）
              // env: { DEVIN_BIN: "/home/user/.local/bin/devin" },
              // 可选：直接提供 API key（无 credentials.toml 的 CI 场景）
              // env: { DEVIN_ACP_API_KEY: "<your-devin-api-key>" },
              // 可选：启用桥接器调试模式
              // env: { DEVIN_ACP_BRIDGE_DEBUG: "1" },
            },
          },
        },
      },
    },
  },

  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace-devin",
    },
    list: [
      {
        id: "main",
        default: true,
        workspace: "~/.openclaw/workspace-devin",
        runtime: {
          type: "acp",
          acp: {
            agent: "devin",
            backend: "acpx",
            mode: "persistent", // 长驻 bridge+devin acp 进程，复用会话
            cwd: "~/.openclaw/workspace-devin",
          },
        },
      },
    ],
  },

  // —— 多 agent / 多 peer 路由示例（按需启用）——
  // bindings: [
  //   { agentId: "main", match: { channel: "yuanbao" } },
  // ],

  // —— 最新 Devin CLI 2026.5.26+ 特性支持（自动启用，无需额外配置）——
  // - ACP 权限持久化：权限授予跨会话保持
  // - MCP 工具权限改进：服务器级别权限批准
  // - 编辑器上下文感知：当前文件、光标位置、标签页信息
  // - 新调试命令：/debug-echo <json> 用于 ACP 测试
  // - 云会话支持：/cloud-attach 和 /cloud-sessions 命令

  channels: {
    yuanbao: {
      // appKey: "<YOUR_YUANBAO_APP_KEY>",
      // appSecret: "<YOUR_YUANBAO_APP_SECRET>",
      dm: { policy: "open" },
      requireMention: true,

      // 出站合并：与 acp.stream.coalesceIdleMs 协调
      outboundQueueStrategy: "merge-text",
      minChars: 2800,
      maxChars: 3000,
      idleMs: 5000,
    },
  },
}
